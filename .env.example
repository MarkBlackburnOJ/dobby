# Dobby runs perfectly with NO configuration at all — the verdict bank and
# stats fall back to local mode. Set these to persist sessions to Supabase.

# Project API URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Service role key. SERVER ONLY — this is never sent to the browser.
# All database access happens inside Next.js route handlers.
SUPABASE_SERVICE_ROLE_KEY=
